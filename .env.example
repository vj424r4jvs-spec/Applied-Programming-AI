# Copy this file to .env and replace the values with your own.

# Supabase dashboard -> your project -> "Connect" button -> "Session pooler" -> URI
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Optional: route scraping traffic through a proxy to hide your IP address.
# Leave empty to connect directly. Examples:
#   Tor (running locally):     socks5h://127.0.0.1:9050
#   SOCKS5 proxy from a VPN:   socks5h://USER:PASS@HOST:PORT
#   HTTP proxy:                http://USER:PASS@HOST:PORT
PROXY_URL=
